+/* debugfs: dump dbg_count 32-bit registers starting at dbg_addr, one
+ * "aaaaaa vvvvvvvv" line each. Unmapped addresses read as 0xdeadbeef on the
+ * YT9224. Debug aid for locating register blocks (e.g. the MIB counters).
+ */
+#define YT921X_DBG_MAX_REGS	8192
+#define YT921X_DBG_LINE_LEN	16
+
+struct yt921x_dbg_dump {
+	char *buf;
+	size_t len;
+};
+
+static int yt921x_dbg_regdump_open(struct inode *inode, struct file *file)
+{
+	struct yt921x_priv *priv = inode->i_private;
+	struct yt921x_dbg_dump *dump;
+	u32 count, addr;
+	int res = 0;
+
+	count = clamp_t(u32, priv->dbg_count, 1, YT921X_DBG_MAX_REGS);
+	addr = priv->dbg_addr & ~3u;
+
+	dump = kzalloc(sizeof(*dump), GFP_KERNEL);
+	if (!dump)
+		return -ENOMEM;
+	dump->buf = kvmalloc((size_t)count * (YT921X_DBG_LINE_LEN + 1),
+			     GFP_KERNEL);
+	if (!dump->buf) {
+		kfree(dump);
+		return -ENOMEM;
+	}
+
+	mutex_lock(&priv->reg_lock);
+	for (u32 i = 0; i < count; i++) {
+		u32 val;
+
+		res = yt921x_reg_read(priv, addr + 4 * i, &val);
+		if (res)
+			break;
+		dump->len += scnprintf(dump->buf + dump->len,
+				       YT921X_DBG_LINE_LEN + 1, "%06x %08x\n",
+				       addr + 4 * i, val);
+	}
+	mutex_unlock(&priv->reg_lock);
+
+	if (res) {
+		kvfree(dump->buf);
+		kfree(dump);
+		return res;
+	}
+
+	file->private_data = dump;
+	return 0;
+}
+
+static ssize_t yt921x_dbg_regdump_read(struct file *file, char __user *ubuf,
+				       size_t size, loff_t *ppos)
+{
+	struct yt921x_dbg_dump *dump = file->private_data;
+
+	return simple_read_from_buffer(ubuf, size, ppos, dump->buf, dump->len);
+}
+
+static int yt921x_dbg_regdump_release(struct inode *inode, struct file *file)
+{
+	struct yt921x_dbg_dump *dump = file->private_data;
+
+	kvfree(dump->buf);
+	kfree(dump);
+	return 0;
+}
+
+static const struct file_operations yt921x_dbg_regdump_fops = {
+	.owner = THIS_MODULE,
+	.open = yt921x_dbg_regdump_open,
+	.read = yt921x_dbg_regdump_read,
+	.release = yt921x_dbg_regdump_release,
+	.llseek = default_llseek,
+};
+
+static void yt921x_dbg_init(struct yt921x_priv *priv, struct device *dev)
+{
+	char name[64];
+
+	snprintf(name, sizeof(name), "yt921x-%s", dev_name(dev));
+	priv->dbg_count = 64;
+	priv->dbg_dir = debugfs_create_dir(name, NULL);
+	debugfs_create_x32("reg_addr", 0600, priv->dbg_dir, &priv->dbg_addr);
+	debugfs_create_u32("reg_count", 0600, priv->dbg_dir, &priv->dbg_count);
+	debugfs_create_file("reg_dump", 0400, priv->dbg_dir, priv,
+			    &yt921x_dbg_regdump_fops);
+}
