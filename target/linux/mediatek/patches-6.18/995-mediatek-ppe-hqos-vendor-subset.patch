From: Nilanka de Silva <nilankadsilva@gmail.com>
Subject: net: mediatek: PPE HQoS subset of the MediaTek vendor series, ported to 6.18
Adds mtk_eth_qos_debugfs.c: /sys/kernel/debug/mtketh/qdma_sch<N>, qdma_txq<N> (vendor-compatible formats) so the
qos_toggle HQoS mode has a shaper/scheduler configuration interface without the SDK mtk_hnat driver.
--- a/drivers/net/ethernet/mediatek/Makefile
+++ b/drivers/net/ethernet/mediatek/Makefile
@@ -4,7 +4,7 @@
 #
 
 obj-$(CONFIG_NET_MEDIATEK_SOC) += mtk_eth.o
-mtk_eth-y := mtk_eth_soc.o mtk_eth_path.o mtk_ppe.o mtk_ppe_debugfs.o mtk_ppe_offload.o
+mtk_eth-y := mtk_eth_soc.o mtk_eth_path.o mtk_ppe.o mtk_ppe_debugfs.o mtk_ppe_offload.o mtk_eth_qos_debugfs.o
 mtk_eth-$(CONFIG_NET_MEDIATEK_SOC_WED) += mtk_wed.o mtk_wed_mcu.o mtk_wed_wo.o
 ifdef CONFIG_DEBUG_FS
 mtk_eth-$(CONFIG_NET_MEDIATEK_SOC_WED) += mtk_wed_debugfs.o
--- /dev/null
+++ b/drivers/net/ethernet/mediatek/mtk_eth_qos_debugfs.c
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Minimal QDMA scheduler / per-queue shaper configuration for MediaTek NETSYS,
+ * file-compatible with the MediaTek SDK "mtketh" debugfs that the PPE HQoS
+ * mode expects (/sys/kernel/debug/mtketh/qdma_sch<N>, qdma_txq<N>).
+ *
+ *   qdma_sch<N>: write "<enable> <sp|wrr> <rate_kbps>"
+ *   qdma_txq<N>: write "<scheduler> <min_en> <min_kbps> <max_en> <max_kbps> <weight> <resv>"
+ * Register recipe follows mtk_set_queue_speed() and the vendor mtk_eth_dbg.c.
+ */
+#include <linux/debugfs.h>
+#include <linux/uaccess.h>
+#include <linux/bitfield.h>
+#include "mtk_eth_soc.h"
+
+static struct dentry *mtk_qos_root;
+
+/* Per-file context. debugfs owns dentry->d_fsdata (it lazily stores its own
+ * struct debugfs_fsdata there), so the scheduler / queue index travels in
+ * inode->i_private instead.
+ */
+struct mtk_qos_file {
+	struct mtk_eth *eth;
+	int id;
+};
+
+static ssize_t qos_ul_dev_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct mtk_eth *eth = file_inode(file)->i_private;
+	struct net_device *dev = NULL;
+	char buf[IFNAMSIZ + 2];
+	int len;
+
+	if (eth->qos_ul_ifindex)
+		dev = dev_get_by_index(&init_net, eth->qos_ul_ifindex);
+	len = scnprintf(buf, sizeof(buf), "%s\n", dev ? dev->name : "none");
+	dev_put(dev);
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static ssize_t qos_ul_dev_write(struct file *file, const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct mtk_eth *eth = file_inode(file)->i_private;
+	struct net_device *dev;
+	char name[IFNAMSIZ + 1] = {};
+
+	if (count >= sizeof(name))
+		return -EINVAL;
+	if (copy_from_user(name, ubuf, count))
+		return -EFAULT;
+	strim(name);
+	if (!name[0] || !strcmp(name, "none")) {
+		eth->qos_ul_ifindex = 0;
+		return count;
+	}
+	dev = dev_get_by_name(&init_net, name);
+	if (!dev)
+		return -ENODEV;
+	eth->qos_ul_ifindex = dev->ifindex;
+	dev_put(dev);
+	return count;
+}
+
+static const struct file_operations qos_ul_dev_fops = {
+	.open = simple_open, .read = qos_ul_dev_read, .write = qos_ul_dev_write, .llseek = default_llseek,
+};
+
+static void mtk_qos_rate_to_man_exp(int rate, int *man, int *exp)
+{
+	*exp = 0;
+	while (rate > 127) {
+		rate /= 10;
+		(*exp)++;
+	}
+	*man = rate;
+}
+
+static ssize_t qdma_sch_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct mtk_qos_file *qf = file_inode(file)->i_private;
+	struct mtk_eth *eth = qf->eth;
+	long id = qf->id;
+	const struct mtk_soc_data *soc = eth->soc;
+	char buf[96];
+	u32 v, sch;
+	int en, wfq, man, exp, len;
+
+	if (mtk_is_netsys_v2_or_greater(eth))
+		v = mtk_r32(eth, soc->reg_map->qdma.tx_sch_rate + (id >> 1) * 0x4);
+	else
+		v = mtk_r32(eth, soc->reg_map->qdma.tx_sch_rate);
+	sch = (id & 1) ? (v >> 16) : v;
+	sch &= MTK_QDMA_TX_SCH;
+	en  = FIELD_GET(MTK_QDMA_TX_SCH_RATE_EN, sch);
+	wfq = FIELD_GET(MTK_QDMA_TX_SCH_MAX_WFQ, sch);
+	man = FIELD_GET(MTK_QDMA_TX_SCH_RATE_MAN, sch);
+	exp = FIELD_GET(MTK_QDMA_TX_SCH_RATE_EXP, sch);
+	while (exp-- > 0)
+		man *= 10;
+	len = scnprintf(buf, sizeof(buf), "sch%ld: enable=%d mode=%s rate=%d kbps\n",
+			id, en, wfq ? "wrr" : "sp", man);
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static ssize_t qdma_sch_write(struct file *file, const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct mtk_qos_file *qf = file_inode(file)->i_private;
+	struct mtk_eth *eth = qf->eth;
+	long id = qf->id;
+	const struct mtk_soc_data *soc = eth->soc;
+	char line[64] = {}, mode[8] = {};
+	int enable, rate, man, exp, shift = (id & 1) ? 16 : 0;
+	u32 val = 0, reg, v;
+
+	if (count >= sizeof(line))
+		return -EINVAL;
+	if (copy_from_user(line, ubuf, count))
+		return -EFAULT;
+	if (sscanf(line, "%d %7s %d", &enable, mode, &rate) != 3)
+		return -EINVAL;
+	if (rate < 0 || rate > (mtk_is_netsys_v3_or_greater(eth) ? 10000000 : 1000000))
+		return -EINVAL;
+	mtk_qos_rate_to_man_exp(rate, &man, &exp);
+	if (enable)
+		val |= MTK_QDMA_TX_SCH_RATE_EN;
+	if (strcmp(mode, "sp") != 0)
+		val |= MTK_QDMA_TX_SCH_MAX_WFQ;
+	val |= FIELD_PREP(MTK_QDMA_TX_SCH_RATE_MAN, man) |
+	       FIELD_PREP(MTK_QDMA_TX_SCH_RATE_EXP, exp);
+
+	reg = soc->reg_map->qdma.tx_sch_rate;
+	if (mtk_is_netsys_v2_or_greater(eth))
+		reg += (id >> 1) * 0x4;
+	spin_lock_bh(&eth->page_lock);
+	v = mtk_r32(eth, reg);
+	v &= ~(MTK_QDMA_TX_SCH << shift);
+	v |= val << shift;
+	mtk_w32(eth, v, reg);
+	spin_unlock_bh(&eth->page_lock);
+	return count;
+}
+
+static ssize_t qdma_txq_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct mtk_qos_file *qf = file_inode(file)->i_private;
+	struct mtk_eth *eth = qf->eth;
+	long id = qf->id;
+	const struct mtk_soc_data *soc = eth->soc;
+	bool v3 = mtk_is_netsys_v3_or_greater(eth) && eth->soc->caps != MT7988_CAPS;
+	char buf[160];
+	u32 sch, cfg, ofs = MTK_QTX_OFFSET * (id % MTK_QTX_PER_PAGE);
+	int min_en, min_man, min_exp, max_en, max_man, max_exp, weight, scheduler, len;
+
+	spin_lock_bh(&eth->page_lock);
+	mtk_w32(eth, id / MTK_QTX_PER_PAGE, soc->reg_map->qdma.page);
+	sch = mtk_r32(eth, soc->reg_map->qdma.qtx_sch + ofs);
+	cfg = mtk_r32(eth, soc->reg_map->qdma.qtx_cfg + ofs);
+	spin_unlock_bh(&eth->page_lock);
+
+	scheduler = mtk_is_netsys_v2_or_greater(eth) ? FIELD_GET(MTK_QTX_SCH_TX_SEL_V2, sch)
+						     : FIELD_GET(MTK_QTX_SCH_TX_SEL, sch);
+	min_en = FIELD_GET(MTK_QTX_SCH_MIN_RATE_EN, sch);
+	if (v3) {
+		min_man = FIELD_GET(MTK_QTX_SCH_MIN_RATE_MAN_V3, sch); min_exp = FIELD_GET(MTK_QTX_SCH_MIN_RATE_EXP_V3, sch);
+		max_en = FIELD_GET(MTK_QTX_SCH_MAX_RATE_EN_V3, sch);
+		max_man = FIELD_GET(MTK_QTX_SCH_MAX_RATE_MAN_V3, sch); max_exp = FIELD_GET(MTK_QTX_SCH_MAX_RATE_EXP_V3, sch);
+		weight = FIELD_GET(MTK_QTX_SCH_MAX_RATE_WEIGHT_V3, sch);
+	} else {
+		min_man = FIELD_GET(MTK_QTX_SCH_MIN_RATE_MAN, sch); min_exp = FIELD_GET(MTK_QTX_SCH_MIN_RATE_EXP, sch);
+		max_en = FIELD_GET(MTK_QTX_SCH_MAX_RATE_EN, sch);
+		max_man = FIELD_GET(MTK_QTX_SCH_MAX_RATE_MAN, sch); max_exp = FIELD_GET(MTK_QTX_SCH_MAX_RATE_EXP, sch);
+		weight = FIELD_GET(MTK_QTX_SCH_MAX_RATE_WEIGHT, sch);
+	}
+	while (min_exp-- > 0) min_man *= 10;
+	while (max_exp-- > 0) max_man *= 10;
+	len = scnprintf(buf, sizeof(buf),
+			"txq%ld: scheduler=%d min_en=%d min=%d kbps max_en=%d max=%d kbps weight=%d hw_resv=%lu sw_resv=%lu\n",
+			id, scheduler, min_en, min_man, max_en, max_man, weight,
+			(unsigned long)FIELD_GET(MTK_QTX_CFG_HW_RESV, cfg),
+			(unsigned long)FIELD_GET(MTK_QTX_CFG_SW_RESV, cfg));
+	return simple_read_from_buffer(ubuf, count, ppos, buf, len);
+}
+
+static ssize_t qdma_txq_write(struct file *file, const char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct mtk_qos_file *qf = file_inode(file)->i_private;
+	struct mtk_eth *eth = qf->eth;
+	long id = qf->id;
+	const struct mtk_soc_data *soc = eth->soc;
+	bool v3 = mtk_is_netsys_v3_or_greater(eth) && eth->soc->caps != MT7988_CAPS;
+	char line[64] = {};
+	int scheduler, min_en, min_rate, max_en, max_rate, weight, resv;
+	int min_man, min_exp, max_man, max_exp, limit;
+	u32 sch = 0, cfg, ofs = MTK_QTX_OFFSET * (id % MTK_QTX_PER_PAGE);
+
+	if (count >= sizeof(line))
+		return -EINVAL;
+	if (copy_from_user(line, ubuf, count))
+		return -EFAULT;
+	if (sscanf(line, "%d %d %d %d %d %d %d", &scheduler, &min_en, &min_rate,
+		   &max_en, &max_rate, &weight, &resv) != 7)
+		return -EINVAL;
+	limit = mtk_is_netsys_v3_or_greater(eth) ? 10000000 : 1000000;
+	if (min_rate < 0 || min_rate > limit || max_rate < 0 || max_rate > limit ||
+	    scheduler < 0 || scheduler > 3 || weight < 0 || resv < 0 || resv > 255)
+		return -EINVAL;
+	mtk_qos_rate_to_man_exp(min_rate, &min_man, &min_exp);
+	mtk_qos_rate_to_man_exp(max_rate, &max_man, &max_exp);
+
+	if (mtk_is_netsys_v2_or_greater(eth))
+		sch |= FIELD_PREP(MTK_QTX_SCH_TX_SEL_V2, scheduler);
+	else
+		sch |= FIELD_PREP(MTK_QTX_SCH_TX_SEL, scheduler);
+	sch |= FIELD_PREP(MTK_QTX_SCH_LEAKY_BUCKET_SIZE, 3);
+	if (min_en)
+		sch |= MTK_QTX_SCH_MIN_RATE_EN;
+	if (v3) {
+		sch |= FIELD_PREP(MTK_QTX_SCH_MIN_RATE_MAN_V3, min_man) | FIELD_PREP(MTK_QTX_SCH_MIN_RATE_EXP_V3, min_exp);
+		if (max_en)
+			sch |= MTK_QTX_SCH_MAX_RATE_EN_V3;
+		sch |= FIELD_PREP(MTK_QTX_SCH_MAX_RATE_WEIGHT_V3, weight) |
+		       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_MAN_V3, max_man) | FIELD_PREP(MTK_QTX_SCH_MAX_RATE_EXP_V3, max_exp);
+	} else {
+		sch |= FIELD_PREP(MTK_QTX_SCH_MIN_RATE_MAN, min_man) | FIELD_PREP(MTK_QTX_SCH_MIN_RATE_EXP, min_exp);
+		if (max_en)
+			sch |= MTK_QTX_SCH_MAX_RATE_EN;
+		sch |= FIELD_PREP(MTK_QTX_SCH_MAX_RATE_WEIGHT, weight) |
+		       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_MAN, max_man) | FIELD_PREP(MTK_QTX_SCH_MAX_RATE_EXP, max_exp);
+	}
+
+	spin_lock_bh(&eth->page_lock);
+	mtk_w32(eth, id / MTK_QTX_PER_PAGE, soc->reg_map->qdma.page);
+	mtk_w32(eth, sch, soc->reg_map->qdma.qtx_sch + ofs);
+	cfg = mtk_r32(eth, soc->reg_map->qdma.qtx_cfg + ofs);
+	cfg &= ~(MTK_QTX_CFG_HW_RESV | MTK_QTX_CFG_SW_RESV);
+	cfg |= FIELD_PREP(MTK_QTX_CFG_HW_RESV, resv) | FIELD_PREP(MTK_QTX_CFG_SW_RESV, resv);
+	mtk_w32(eth, cfg, soc->reg_map->qdma.qtx_cfg + ofs);
+	spin_unlock_bh(&eth->page_lock);
+	return count;
+}
+
+static const struct file_operations qdma_sch_fops = {
+	.open = simple_open, .read = qdma_sch_read, .write = qdma_sch_write, .llseek = default_llseek,
+};
+static const struct file_operations qdma_txq_fops = {
+	.open = simple_open, .read = qdma_txq_read, .write = qdma_txq_write, .llseek = default_llseek,
+};
+
+int mtk_eth_qos_debugfs_init(struct mtk_eth *eth)
+{
+	struct mtk_qos_file *qf;
+	char name[16];
+	int i, nq = eth->soc->num_tx_queues;
+	int ns = mtk_is_netsys_v3_or_greater(eth) ? 4 : 2;
+
+	if (mtk_qos_root)
+		return 0;
+	qf = devm_kcalloc(eth->dev, ns + nq, sizeof(*qf), GFP_KERNEL);
+	if (!qf)
+		return -ENOMEM;
+	mtk_qos_root = debugfs_create_dir("mtketh", NULL);
+	if (IS_ERR_OR_NULL(mtk_qos_root))
+		return -ENOMEM;
+	for (i = 0; i < ns; i++) {
+		qf[i].eth = eth;
+		qf[i].id = i;
+		snprintf(name, sizeof(name), "qdma_sch%d", i);
+		debugfs_create_file(name, 0644, mtk_qos_root, &qf[i], &qdma_sch_fops);
+	}
+	for (i = 0; i < nq; i++) {
+		qf[ns + i].eth = eth;
+		qf[ns + i].id = i;
+		snprintf(name, sizeof(name), "qdma_txq%d", i);
+		debugfs_create_file(name, 0644, mtk_qos_root, &qf[ns + i], &qdma_txq_fops);
+	}
+	debugfs_create_file("qos_ul_dev", 0644, mtk_qos_root, eth, &qos_ul_dev_fops);
+	return 0;
+}
+
+void mtk_eth_qos_debugfs_exit(void)
+{
+	debugfs_remove_recursive(mtk_qos_root);
+	mtk_qos_root = NULL;
+}
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -5135,6 +5135,18 @@ static u16 mtk_select_queue(struct net_d
 		queue = mac->id;
 	}
 
+	/* HQoS: CPU-transmitted packets (tunnel encapsulation, locally
+	 * generated, non-offloaded forwards) pick a class queue from the
+	 * skb mark, bits 16-20, when HQoS mode is on. Ids below 12 are the
+	 * GMAC and DSA port queues on MT7988 and are left to the layout above.
+	 */
+	if (mac->hw->qos_toggle == 1) {
+		unsigned int q = (skb->mark >> 16) & (mac->hw->soc->num_tx_queues - 1);
+
+		if (q >= 12)
+			queue = q;
+	}
+
 	if (queue >= dev->num_tx_queues)
 		queue = 0;
 
