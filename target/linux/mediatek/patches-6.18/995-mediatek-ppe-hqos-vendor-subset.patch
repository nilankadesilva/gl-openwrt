+static inline int
+mtk_dev_link_speed(struct mtk_eth *eth, struct net_device *dev)
+{
+	size_t i;
+
+	if (!dev)
+		return SPEED_UNKNOWN;
+
+	if (dev->phydev)
+		return READ_ONCE(dev->phydev->speed);
+
+	for (i = 0; i < ARRAY_SIZE(eth->netdev); i++) {
+		if (dev == eth->netdev[i]) {
+			struct mtk_mac *mac = netdev_priv(dev);
+			return READ_ONCE(mac->speed);
+		}
+	}
+
+	return SPEED_UNKNOWN;
+}
+
+static inline int
+mtk_ppe_check_pppq_path(struct mtk_eth *eth, struct net_device *idev,
+			struct net_device *odev, int dsa_port)
+{
+	bool wifi_rx = idev && !!(idev->ieee80211_ptr);
+	int odev_speed;
+
+	if ((dsa_port >= 0 && dsa_port <= 4) ||
+	    (dsa_port == 5 && wifi_rx))
+		return 1;
+
+	odev_speed = mtk_dev_link_speed(eth, odev);
+	if (odev_speed <= 0)
+		return 0;
+
+	if (mtk_is_netsys_v3_or_greater(eth)) {
+		/* Handle cases of GMAC port linked less or equal to 1Gbps */
+		if (odev_speed <= SPEED_1000)
+			return 1;
+	}
+
+	return 0;
+}
