#!/bin/sh /etc/rc.common
# lcdd: DRM text console daemon for the SPI LCD; lcd-clock (START=99) writes to its FIFO
START=98
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/lcdd -f /tmp/lcd.fifo
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
